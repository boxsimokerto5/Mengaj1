rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User accounts collection for SRT 1 Kediri authentication
    match /app_users/{username} {
      allow read, write: if true;
    }

    // Students and records collections
    match /users/{userId}/students/{studentId} {
      allow read, write: if true;
    }

    match /users/{userId}/records/{recordId} {
      allow read, write: if true;
    }

    match /students/{studentId} {
      allow read, write: if true;
    }

    match /records/{recordId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
